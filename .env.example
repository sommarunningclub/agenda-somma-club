# ============================================================================
# Agenda Somma Club — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA comite .env.local.
# ============================================================================

# URL pública do site (sem barra no final). Em produção use o domínio da Vercel
# ou o domínio próprio. Em dev pode deixar http://localhost:3000.
# É usada para montar os links webcal:// , Google e Outlook.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase (obrigatório para feed real, admin e leads) ------------------
# Encontre em: Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server-only. Bypassa RLS — usado para gerar o .ics e nas escritas do admin.
# NUNCA exponha no client. (pode repetir a URL acima em SUPABASE_URL)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role...

# ---- Admin -----------------------------------------------------------------
# Senha do painel /admin/agenda. Este é o "primeiro usuário admin".
AGENDA_ADMIN_PASSWORD=troque-esta-senha

# Segredo para assinar o cookie de sessão (HMAC). Gere algo aleatório:
#   openssl rand -base64 32
# Se não definir, cai para AUTH_SECRET ou SUPABASE_SERVICE_ROLE_KEY.
AGENDA_SESSION_SECRET=

# ---- Tracking (opcional) ---------------------------------------------------
# Só são injetados se preenchidos. Não invente IDs.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
